# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored and must never be committed.

# --- PostgreSQL (used by the `db` service and to build DATABASE_URL) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=edr_logs

# --- Backend ---
# Comma-separated list of browser origins allowed to call the API.
# Keep this restricted; do NOT use "*".
CORS_ORIGINS=http://localhost:5173

# Only needed when running the backend outside Docker Compose
# (e.g. `uvicorn main:app` locally). Inside Compose, DATABASE_URL is
# built automatically from the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://user:change_this_password@localhost:5432/edr_logs

# --- Frontend ---
VITE_API_URL=http://localhost:8000
