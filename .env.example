# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored and must never be committed.

# --- PostgreSQL (used by the `db` service and to build DATABASE_URL) ---
# These credentials are ALSO the application's admin login by default: the same
# user/password opens the app and connects to the database (see bootstrap.py).
# There is no separate "create admin" step. Set a strong POSTGRES_PASSWORD.
POSTGRES_USER=user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=edr_logs

# --- Backend ---
# Comma-separated list of browser origins allowed to call the API.
# Keep this restricted; do NOT use "*".
CORS_ORIGINS=http://localhost:5173

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=200

# Optional: use a different login for the app than for PostgreSQL. Left empty,
# the app admin is POSTGRES_USER / POSTGRES_PASSWORD.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Generated-graph cache: how many datasets to keep in memory and for how long
# (seconds). Set GRAPH_CACHE_TTL_SECONDS=0 to disable expiry.
GRAPH_CACHE_SIZE=4
GRAPH_CACHE_TTL_SECONDS=300

# Fan-out hubs with more than this many exclusively-owned descendants have them
# collapsed into a "+N" placeholder that loads on demand. Set 0 to disable.
CLUSTER_MIN_CHILDREN=50

# Secret used to sign session cookies. Generate a strong random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, the backend falls back to an ephemeral key (sessions are lost on
# every restart), so set it for anything beyond local development.
SECRET_KEY=change_this_to_a_long_random_value

# Set to true when the app is served over HTTPS so the session cookie is only
# sent over secure connections.
SESSION_COOKIE_SECURE=false

# Only needed when running the backend outside Docker Compose
# (e.g. `uvicorn main:app` locally). Inside Compose, DATABASE_URL is
# built automatically from the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://user:change_this_password@localhost:5432/edr_logs

# --- Frontend ---
VITE_API_URL=http://localhost:8000
